{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "HackerNewsConfiguration": {
    "CacheExpiryTimeoutSeconds": 60,
    "SemaphoreWaitTimeoutSeconds": 10,
    "MaxStoryRequestCount": 1000,
    "MaxDegreeOfParallelism": 5
  }
}
